{
  "compilerOptions": {
    "rootDirs": ["./src/test/samples/sampleControl"],
    "outDir": "./src/test/dist",
    "target": "es2022",
    "module": "node16",
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": false,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["openui5"]
  },
  "include": ["./src/test/samples/sampleControl/**/*"]
}
